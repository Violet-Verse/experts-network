# Supabase connection for /api/submit-application
# Project Settings -> API in your Supabase dashboard.
# Use the service_role key (server-side only, never exposed to the client) —
# the table has row level security enabled with no public policies, so
# only the service role can read/write it.
# NEXT_PUBLIC_SUPABASE_URL is also accepted as a fallback for SUPABASE_URL
# (e.g. if the Supabase Vercel integration created it under that name), but
# never use the anon/publishable key here — it has no write access to the table.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_TABLE_NAME=Expert_Network

# Client-side Supabase (browser). Vite only exposes VITE_-prefixed vars to
# the client bundle. Use the anon/publishable key here — NEVER the
# service_role key. Powers auth (magic link login) and the dashboard's
# read-only opportunities query.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: name of the opportunities table if you rename it from the
# default "opportunities".
SUPABASE_OPPORTUNITIES_TABLE=opportunities

# Optional but recommended: protects /api/sync-opportunities from being
# triggered by anyone who finds the URL. Vercel Cron automatically sends
# this as "Authorization: Bearer <CRON_SECRET>" when the env var is set.
CRON_SECRET=
