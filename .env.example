# Supabase connection for /api/submit-application
# Project Settings -> API in your Supabase dashboard.
# Use the service_role key (server-side only, never exposed to the client) —
# the table has row level security enabled with no public policies, so
# only the service role can read/write it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_TABLE_NAME=applications
